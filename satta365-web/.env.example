# Satta365 Web Environment Variables

# ASP.NET .asmx Backend Base URL
# In development, leave blank or set to /APIs to use Vite dev proxy:
VITE_API_BASE_URL=/APIs
# Set this to the reachable backend origin (without the /APIs path):
VITE_API_PROXY_TARGET=https://sattareddyanna.com

# In production, set to your deployed ASP.NET backend endpoint:
# VITE_API_BASE_URL=https://sattareddyanna.com/APIs

# SMS gateway base URL. The Vite development proxy forwards /SMS to the configured host's /APIs.
# In production, configure a same-origin /SMS reverse proxy or set a CORS-enabled HTTPS URL.
VITE_SMS_API_BASE_URL=/SMS
# Replace this retired gateway with the active SMS gateway origin (without the /APIs path):
VITE_SMS_PROXY_TARGET=https://betzuno.com

# Authentication / Security Token (Matches Java token)
VITE_API_TOKEN=KLARMNLNIHJAESJV
